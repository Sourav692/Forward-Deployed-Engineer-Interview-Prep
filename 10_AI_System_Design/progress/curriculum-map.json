{
  "program": "Architecture-Driven Staff AI System Design",
  "version": "3.0",
  "target": "Staff FDE / Applied AI Engineer",
  "stage_count": 12,
  "domain_count": 18,
  "module_count": 56,
  "stages": [
    {
      "stage": 1,
      "name": "Build the MVP",
      "trigger": "A single enterprise user can authenticate, ask a question, receive a hosted-model response, and view a saved request.",
      "architecture_after": "An API application, database, minimal hosted-model adapter, and a documented baseline request path.",
      "architecture_before": "No system exists; only requirements.",
      "output_dir": "stages/01-mvp"
    },
    {
      "stage": 2,
      "name": "Distributed Execution",
      "trigger": "Document processing and long-running tasks block interactive requests or are lost on worker failure.",
      "architecture_after": "Durable job API, queue, workers, retry boundaries, idempotency, and stored job state.",
      "architecture_before": "The verified architecture after Stage 1.",
      "output_dir": "stages/02-distributed-execution"
    },
    {
      "stage": 3,
      "name": "Enterprise Knowledge",
      "trigger": "Users need trustworthy answers from changing internal documents without exposing restricted files.",
      "architecture_after": "Connector ingestion, search index, metadata, source synchronization, and permission-filtered retrieval.",
      "architecture_before": "The verified architecture after Stage 2.",
      "output_dir": "stages/03-enterprise-knowledge"
    },
    {
      "stage": 4,
      "name": "Scale the Application",
      "trigger": "Traffic rises from a pilot to broad enterprise usage; latency and database load rise.",
      "architecture_after": "Stateless replicas, caching, capacity math, autoscaling policies, and measured bottlenecks.",
      "architecture_before": "The verified architecture after Stage 3.",
      "output_dir": "stages/04-application-scaling"
    },
    {
      "stage": 5,
      "name": "Handle Overload and Fair Scheduling",
      "trigger": "One tenant floods a shared model provider; others miss latency targets and queues grow.",
      "architecture_after": "Admission limits, bounded per-tenant queues, weighted scheduling, concurrency limits, rejection policies, and metrics.",
      "architecture_before": "The verified architecture after Stage 4.",
      "output_dir": "stages/05-overload-fairness"
    },
    {
      "stage": 6,
      "name": "Enterprise Security",
      "trigger": "Multiple customer organizations demand strict isolation, identity, audit, and private connectivity.",
      "architecture_after": "Tenant-aware auth/authz, trust boundaries, auditing, secrets, private connectivity, and isolated data policies.",
      "architecture_before": "The verified architecture after Stage 5.",
      "output_dir": "stages/06-enterprise-security"
    },
    {
      "stage": 7,
      "name": "Reliability and Consistency",
      "trigger": "Replica lag, crashes, dependency outages, and retries yield stale states or duplicate effects.",
      "architecture_after": "Consistency choices by data class, circuit breakers, retries, failover, runbooks, and end-to-end traces.",
      "architecture_before": "The verified architecture after Stage 6.",
      "output_dir": "stages/07-reliability-consistency"
    },
    {
      "stage": 8,
      "name": "Production AI Quality and Releases",
      "trigger": "A model or retrieval change silently reduces accuracy or increases cost and latency.",
      "architecture_after": "Versioned eval datasets, release gates, canary/shadow tests, observability, and rollback.",
      "architecture_before": "The verified architecture after Stage 7.",
      "output_dir": "stages/08-evaluation-releases"
    },
    {
      "stage": 9,
      "name": "Inference and GPU Infrastructure",
      "trigger": "Hosted provider spend and latency force evaluation of routing and self-hosted serving.",
      "architecture_after": "Model-serving gateway, inference performance budget, self-hosted deployment option, and GPU placement boundaries.",
      "architecture_before": "The verified architecture after Stage 8.",
      "output_dir": "stages/09-inference-gpu"
    },
    {
      "stage": 10,
      "name": "Fine-Tuning and Model Customization",
      "trigger": "Selected customers require specialized model behavior; ad-hoc training cannot be governed.",
      "architecture_after": "Dataset/version pipeline, training job control, tracking, checkpoints, evaluation, registry, and approval.",
      "architecture_before": "The verified architecture after Stage 9.",
      "output_dir": "stages/10-fine-tuning"
    },
    {
      "stage": 11,
      "name": "Global Multi-Region Platform",
      "trigger": "Data residency, regional traffic, outages, and enterprise SLAs change deployment constraints.",
      "architecture_after": "Regional control/data boundaries, routing, DR, capacity planning, and governance.",
      "architecture_before": "The verified architecture after Stage 10.",
      "output_dir": "stages/11-multi-region"
    },
    {
      "stage": 12,
      "name": "Staff-Level Platform Architecture",
      "trigger": "The platform must serve many internal teams and customers without becoming a fragile custom project.",
      "architecture_after": "Reference architecture, ADR portfolio, phased migration, platform abstractions, TCO, operating model, and final defense.",
      "architecture_before": "The verified architecture after Stage 11.",
      "output_dir": "stages/12-staff-platform"
    }
  ],
