APP_ENV=local
DATABASE_URL=postgresql+psycopg://genai:genai@localhost:5432/genai_fde
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_LLM_PROVIDER=mock
EVAL_MIN_RAG_SCORE=0.85
EVAL_MAX_PERMISSION_LEAKS=0

# Semantic embedding configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_CACHE_DIR=.cache/models
EMBEDDING_RESULT_CACHE_PATH=.cache/embeddings/index.sqlite3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Optional Vertex AI adapter
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_EMBEDDING_MODEL=text-embedding-005
