{
  "name": "forward-deployed",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "check:content": "node scripts/check-parse.ts",
    "check:curriculum": "node scripts/check-curriculum.ts",
    "check:rules": "node scripts/check-progress-rules.ts",
    "check:store": "node scripts/check-progress-store.ts",
    "predev": "npm run sync",
    "dev": "next dev",
    "prebuild": "npm run sync && node scripts/curriculum-index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:paths": "node scripts/check-paths.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "import:rag-theory": "node scripts/rag-theory-import.mjs",
    "check:rag-import": "node scripts/check-rag-import.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@vercel/analytics": "^2.0.1",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
